# ─── Django Core ──────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com


TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Database ─────────────────────────────────────────────
# Set USE_SQLITE=True for local dev (no PostgreSQL required)
USE_SQLITE=True
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=portfolio_password
DB_HOST=localhost
DB_PORT=5432

# ─── Cloudinary (media storage) ───────────────────────────
# Leave blank to use local file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email ────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@petercharles.dev
CONTACT_EMAIL=peter@petercharles.dev

# ─── Site ─────────────────────────────────────────────────
SITE_URL=https://petercharles.dev
